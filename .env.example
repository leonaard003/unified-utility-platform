# Copy to .env.local and adjust. Every value here is optional — the app runs with defaults.

# Absolute path to the yt-dlp binary. Leave unset to auto-detect `yt-dlp` on PATH.
# The downloader module is DISABLED (with an explicit in-app notice) when this is missing.
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Absolute path to the ffmpeg binary. Leave unset to auto-detect `ffmpeg` on PATH.
# Audio/video conversion is DISABLED (with an explicit in-app notice) when this is missing.
# FFMPEG_PATH=/usr/bin/ffmpeg

# Absolute path to LibreOffice `soffice`. Leave unset to auto-detect.
# When missing, DOCX -> PDF falls back to a text-only layout (clearly labelled in the UI).
# SOFFICE_PATH=/usr/bin/soffice

# Python interpreter that has faster-whisper installed for live transcription.
# In Docker we install it into /opt/yt-dlp-venv/bin/python.
# UUP_ASR_PYTHON=/opt/yt-dlp-venv/bin/python

# Whisper model + CPU mode. Keep tiny/base on small VPS boxes.
# UUP_WHISPER_MODEL=tiny
# UUP_WHISPER_COMPUTE_TYPE=int8
# UUP_WHISPER_BEAM_SIZE=1

# Directory for temporary uploads/outputs. Defaults to <project>/tmp
# UUP_TMP_DIR=/var/tmp/uup

# Minutes before a temp file is swept. Default 30.
# UUP_TMP_TTL_MINUTES=30

# Max upload size in megabytes for the converter. Default 100.
# UUP_MAX_UPLOAD_MB=100

# Max download size in megabytes the downloader will stream back. Default 300.
# UUP_MAX_DOWNLOAD_MB=300
